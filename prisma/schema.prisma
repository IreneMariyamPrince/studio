// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // Use 'native' first to allow Prisma to attempt auto-detection based on the OS.
  // Keep the specific debian target as a fallback, although it's the one currently causing issues.
  // The 'linux-musl-openssl-3.0.x' target is added for environments using musl libc (like Alpine Linux).
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"] // Required for neon driver adapter
}

datasource db {
  provider = "mysql" // Specify MySQL provider
  url      = env("DATABASE_URL") // Use environment variable for the connection string
}

// --- Core Models ---

model Account {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(10) // Unique code for the account
  name        String
  type        String    // e.g., Asset, Liability, Equity, Revenue, Expense
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  expenses    Expense[] // An account can have many expenses
  invoiceItems InvoiceItem[] @relation("AccountInvoiceItems") // Link items directly to accounts if needed for reporting

  @@index([type])
  @@index([name])
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting account if expenses exist
  amount      Decimal   @db.Decimal(10, 2) // Store amounts precisely
  description String?
  receiptUrl  String?   @db.VarChar(2048) // URL to the stored receipt image/PDF
  status      String    // e.g., Pending, Approved, Rejected
  userId      String?   // Link to the user who submitted the expense (if needed)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([status])
  @@index([accountId])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoices Invoice[] // A client can have many invoices
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // e.g., INV-001
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting client if invoices exist
  issueDate     DateTime
  dueDate       DateTime
  status        String        // e.g., Draft, Pending, Paid, Overdue, Cancelled
  total         Decimal       @db.Decimal(12, 2) // Total amount of the invoice
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  items         InvoiceItem[] // An invoice has many items

  @@index([status])
  @@index([clientId])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items if invoice is deleted
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(12, 2) // quantity * unitPrice
  accountId   String?  // Optional: Link item to a revenue/service account
  account     Account? @relation("AccountInvoiceItems", fields: [accountId], references: [id], onDelete: SetNull) // If account deleted, set this to null

  @@index([invoiceId])
  @@index([accountId])
}


// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  // Explicitly list binary targets to potentially resolve libssl issues
  // 'native' attempts to use system libraries.
  // 'debian-openssl-3.0.x' is for systems with OpenSSL 3.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Chart of Accounts ---
model Account {
  id          String    @id @default(cuid())
  code        String    @unique // Unique account code (e.g., 1010)
  name        String    // Account name (e.g., Cash, Accounts Receivable)
  type        String    // Account type (Asset, Liability, Equity, Revenue, Expense)
  description String?   // Optional description
  expenses    Expense[] // Relation to Expenses
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
}

// --- Expenses ---
model Expense {
  id          String    @id @default(cuid())
  date        DateTime  // Date the expense occurred
  accountId   String    // Foreign key to Account
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting account if expenses exist
  amount      Float     // Expense amount
  description String?   // Optional description
  receiptUrl  String?   // Optional URL to the receipt image/file
  status      String    // Status (Pending, Approved, Rejected)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([status])
}

// --- Clients ---
model Client {
  id        String   @id @default(cuid())
  name      String   // Client name
  email     String?  @unique // Optional but unique email
  address   String?  // Optional address
  invoices  Invoice[] // Relation to Invoices
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Invoices ---
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // Unique invoice number (e.g., INV-001)
  clientId      String        // Foreign key to Client
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting client if invoices exist
  issueDate     DateTime      // Date the invoice was issued
  dueDate       DateTime      // Date the invoice is due
  status        String        // Status (Draft, Pending, Paid, Overdue, Cancelled)
  notes         String?       // Optional notes for the client
  total         Float         // Total amount of the invoice
  items         InvoiceItem[] // Relation to InvoiceItems
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

// --- Invoice Items ---
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   // Foreign key to Invoice
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items when invoice is deleted
  description String   // Description of the item/service
  quantity    Int      // Quantity
  unitPrice   Float    // Price per unit
  total       Float    // Calculated total for the line item (quantity * unitPrice)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

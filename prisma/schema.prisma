// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Make sure DATABASE_URL is set in your .env file
}

// Chart of Accounts
model Account {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(10) // Unique code for the account
  name        String
  type        AccountType // Asset, Liability, Equity, Revenue, Expense
  description String?   @db.Text // Optional longer description
  expenses    Expense[] // Relation to Expenses
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

// Clients
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique // Optional but unique if provided
  address   String?  @db.Text
  invoices  Invoice[] // Relation to Invoices
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Invoices
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // e.g., INV-001
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting client if invoices exist
  issueDate     DateTime      @db.Date // Date invoice was issued
  dueDate       DateTime      @db.Date // Date invoice is due
  status        InvoiceStatus // Draft, Pending, Paid, Overdue, Cancelled
  notes         String?       @db.Text // Optional notes for the client
  total         Float         // Calculated total amount
  items         InvoiceItem[] // Relation to Invoice Items
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}

// Invoice Items
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items if invoice is deleted
  description String  @db.Text
  quantity    Int
  unitPrice   Float
  total       Float   // quantity * unitPrice
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

// Expenses
model Expense {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date // Date of the expense
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting account if expenses exist
  amount      Float
  description String?       @db.Text
  receiptUrl  String?       // URL to the uploaded receipt image/pdf
  status      ExpenseStatus // Pending, Approved, Rejected
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([date])
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Explicitly specify binary targets, adding 'native' and openssl-3.0.x
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Ensure this environment variable is set
}

// --- Chart of Accounts ---
model Account {
  id          String    @id @default(cuid())
  code        String    @unique // Ensure codes are unique
  name        String
  type        AccountType // Enum for account types
  description String? // Optional description

  expenses Expense[] // Relation to Expenses
  // Add other relations as needed (e.g., link to Invoice items, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

// --- Expenses ---
model Expense {
  id          String        @id @default(cuid())
  date        DateTime
  amount      Float
  description String?
  receiptUrl  String? // Optional URL for uploaded receipt
  status      ExpenseStatus @default(Pending) // Enum for status

  accountId String // Foreign key to Account
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting account if expenses exist

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}

// --- Clients ---
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique // Optional but unique if provided
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[] // Relation to Invoices
}

// --- Invoices ---
model Invoice {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique // Generated invoice number
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(Draft) // Enum for status
  notes         String?
  total         Float // Calculated total amount

  clientId String // Foreign key to Client
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting client if invoices exist

  items InvoiceItem[] // Relation to Invoice Items

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}

// --- Invoice Items ---
model InvoiceItem {
  id          String @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float
  total       Float // Calculated total for the item (quantity * unitPrice)

  invoiceId String // Foreign key to Invoice
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items if invoice is deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Explicitly specify binary targets for compatibility
  // 'native' covers the build environment if different from runtime
  // 'debian-openssl-3.0.x' is common for modern Linux distributions
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Make sure DATABASE_URL is set in your .env file
}

// Chart of Accounts
model Account {
  id          String    @id @default(cuid())
  code        String    @unique // Unique account code (e.g., 1010)
  name        String    // Account name (e.g., Cash, Accounts Receivable)
  type        String    // Account type (Asset, Liability, Equity, Revenue, Expense)
  description String?   // Optional description
  expenses    Expense[] // Relation to Expenses

  @@index([type])
}

// Expenses
model Expense {
  id          String    @id @default(cuid())
  date        DateTime  // Date the expense occurred
  accountId   String    // Foreign key to Account
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting Account if linked
  amount      Float     // Expense amount
  description String?   // Optional description
  receiptUrl  String?   // Optional URL/path to the receipt image/PDF
  status      String    // Status (e.g., Pending, Approved, Rejected)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([accountId])
  @@index([date])
}

// Clients
model Client {
  id        String    @id @default(cuid())
  name      String    // Client name
  email     String?   @unique // Optional but unique email
  address   String?   // Optional address
  invoices  Invoice[] // Relation to Invoices
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Invoices
model Invoice {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique // Generated invoice number (e.g., INV-0001)
  clientId      String       // Foreign key to Client
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting Client if linked
  issueDate     DateTime     // Date the invoice was issued
  dueDate       DateTime     // Date the invoice is due
  status        String       // Status (e.g., Draft, Pending, Paid, Overdue, Cancelled)
  notes         String?      // Optional notes for the client
  items         InvoiceItem[] // Relation to Invoice Items
  total         Float        // Calculated total amount of the invoice
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clientId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([status])
}

// Invoice Items
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  // Foreign key to Invoice
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete item if invoice is deleted
  description String  // Description of the service/product
  quantity    Int     // Quantity
  unitPrice   Float   // Price per unit
  total       Float   // Calculated total for the line item (quantity * unitPrice)

  @@index([invoiceId])
}

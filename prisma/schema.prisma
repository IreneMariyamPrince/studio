// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Explicitly define binary targets for compatibility
  // Include 'native' for the build environment and specific targets for deployment if needed.
  // 'debian-openssl-1.1.x' is often needed for older Debian/Ubuntu.
  // 'debian-openssl-3.0.x' is needed for newer Debian/Ubuntu.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// === Chart of Accounts ===
model Account {
  id          String    @id @default(cuid())
  code        String    @unique // e.g., 1010, 6000
  name        String    // e.g., Cash, Office Supplies Expense
  type        AccountType // Defined below
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  expenses    Expense[] // An account can be linked to many expenses

  @@index([type])
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

// === Expenses ===
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  accountId   String   // Foreign key to Account
  amount      Float    // Using Float for currency, consider Decimal if precision is critical
  description String?
  receiptUrl  String?  // URL to the uploaded receipt image/PDF
  status      ExpenseStatus @default(Pending) // Defined below
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting account if expenses exist

  @@index([accountId])
  @@index([date])
  @@index([status])
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}


// === Invoices ===
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  invoices  Invoice[] // A client can have many invoices
}

model Invoice {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique // e.g., INV-0001
  clientId      String       // Foreign key to Client
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(Draft) // Defined below
  notes         String?
  total         Float        // Calculated total amount
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting client if invoices exist
  items         InvoiceItem[] // An invoice has many items

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   // Foreign key to Invoice
  description String
  quantity    Int
  unitPrice   Float
  total       Float // Calculated total for the item (quantity * unitPrice)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items when invoice is deleted

  @@index([invoiceId])
}

enum InvoiceStatus {
  Draft
  Pending // Sent, awaiting payment
  Paid
  Overdue
  Cancelled
}

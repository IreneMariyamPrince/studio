// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Explicitly specify binary targets. 'native' tries to detect the OS.
  // Added 'debian-openssl-3.0.x' as OpenSSL 1.1 is often missing on newer systems.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Chart of Accounts Model
model Account {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., 1010
  name        String   // e.g., Cash, Accounts Receivable
  type        AccountType // Asset, Liability, Equity, Revenue, Expense
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  expenses Expense[] // An account can be associated with many expenses

  @@index([type])
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

// Expense Model
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  accountId   String   // Foreign key to Account
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict) // Link to Account
  amount      Float
  description String?
  receiptUrl  String?  // URL or path to the uploaded receipt file
  status      ExpenseStatus @default(Pending) // Pending, Approved, Rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([date])
  @@index([status])
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}


// Client Model (for Invoicing)
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoices Invoice[] // A client can have many invoices
}

// Invoice Model
model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique // e.g., INV-0001
  clientId      String    // Foreign key to Client
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Restrict) // Link to Client
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(Draft) // Draft, Pending, Paid, Overdue, Cancelled
  notes         String?
  total         Float     // Calculated total amount
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  items         InvoiceItem[] // An invoice has many items

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}

// Invoice Item Model
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  // Foreign key to Invoice
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Link to Invoice
  description String
  quantity    Int
  unitPrice   Float
  total       Float   // Calculated quantity * unitPrice

  @@index([invoiceId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Add or modify binaryTargets
  binaryTargets = ["native", "debian-openssl-3.0.x"] // Use system's OpenSSL or OpenSSL 3.0
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Ensure this is set in your .env file
}

// --- Chart of Accounts ---
model Account {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(10) // Unique account code
  name        String   @db.VarChar(255)
  type        AccountType // Enum for account types
  description String?  @db.Text
  expenses    Expense[] // Relation to expenses
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

// --- Expenses ---
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  accountId   String   @map("account_id") // Foreign key to Account
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Decimal  @db.Decimal(10, 2) // Store amount with precision
  description String?  @db.Text
  receiptUrl  String?  @map("receipt_url") @db.VarChar(1024) // URL to the uploaded receipt
  status      ExpenseStatus @default(Pending) // Enum for expense status
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}

// --- Invoices ---
model Client {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  email     String?  @unique @db.VarChar(255) // Optional but unique email
  address   String?  @db.Text
  invoices  Invoice[] // Relation to invoices
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique @map("invoice_number") @db.VarChar(50) // Unique invoice number
  clientId      String       @map("client_id") // Foreign key to Client
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent client deletion if invoices exist
  issueDate     DateTime     @map("issue_date")
  dueDate       DateTime     @map("due_date")
  status        InvoiceStatus @default(Draft) // Enum for invoice status
  notes         String?      @db.Text
  total         Decimal      @db.Decimal(10, 2) // Total amount of the invoice
  items         InvoiceItem[] // Relation to invoice items
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id") // Foreign key to Invoice
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items when invoice is deleted
  description String   @db.Text
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2) // Calculated total for the item
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

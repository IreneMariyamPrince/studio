// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Explicitly define binary targets. Add 'native' to potentially use a locally built engine.
  // Keep the debian target as it's often needed for deployment environments.
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  // Ensure the DATABASE_URL environment variable is set correctly
  // Example: DATABASE_URL="mysql://user:password@host:port/database"
  url      = env("DATABASE_URL")
}

// --- Chart of Accounts ---
model Account {
  id          String    @id @default(cuid())
  code        String    @unique // Unique account code (e.g., 1010, 6050)
  name        String    // Account name (e.g., Cash, Office Supplies)
  type        String    // Account type (Asset, Liability, Equity, Revenue, Expense)
  description String?   // Optional description
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[] // Relation to Expenses

  @@index([type])
}

// --- Expenses ---
model Expense {
  id          String    @id @default(cuid())
  date        DateTime  // Date the expense occurred
  accountId   String    // Foreign key linking to the Account
  account     Account   @relation(fields: [accountId], references: [id])
  amount      Float     // Amount of the expense
  description String?   // Optional description
  receiptUrl  String?   // Optional URL to the receipt image/PDF
  status      String    // Status (e.g., Pending, Approved, Rejected)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([accountId])
  @@index([date])
  @@index([status])
}

// --- Clients ---
model Client {
  id        String   @id @default(cuid())
  name      String   // Client's name
  email     String?  @unique // Client's email (optional but unique if provided)
  address   String?  // Client's address (optional)
  invoices  Invoice[] // Relation to Invoices
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Invoices ---
model Invoice {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique // Unique invoice number (e.g., INV-0001)
  clientId      String       // Foreign key linking to the Client
  client        Client       @relation(fields: [clientId], references: [id])
  issueDate     DateTime     // Date the invoice was issued
  dueDate       DateTime     // Date the invoice is due
  status        String       // Status (e.g., Draft, Pending, Paid, Overdue, Cancelled)
  notes         String?      // Optional notes for the client
  total         Float        // Total amount of the invoice
  items         InvoiceItem[] // Relation to InvoiceItems
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

// --- Invoice Items ---
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  // Foreign key linking to the Invoice
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Cascade delete items when invoice is deleted
  description String  // Description of the item/service
  quantity    Int     // Quantity
  unitPrice   Float   // Price per unit
  total       Float   // Calculated total for the item (quantity * unitPrice)

  @@index([invoiceId])
}

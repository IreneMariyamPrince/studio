// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Force the use of the OpenSSL 3.0 binary for compatibility with newer systems
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// --- Chart of Accounts ---
model Account {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(10) // Ensure unique and set max length
  name        String    @db.VarChar(100)
  type        AccountType
  description String?   @db.Text // Optional longer description
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses    Expense[] // Relation to Expenses

  @@index([type])
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}


// --- Expenses ---
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  accountId   String   @map("account_id")
  amount      Decimal  @db.Decimal(10, 2) // Example: Up to 99,999,999.99
  description String?  @db.Text
  receiptUrl  String?  @map("receipt_url") @db.VarChar(2048) // URL for the receipt image/PDF
  status      ExpenseStatus @default(Pending)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict) // Prevent deleting account if expenses exist

  @@index([date])
  @@index([accountId])
  @@index([status])
}

enum ExpenseStatus {
  Pending
  Approved
  Rejected
}


// --- Invoicing ---
model Client {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(150)
  email     String?  @unique @db.VarChar(255)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices  Invoice[] // Relation to Invoices

  @@index([name])
  @@index([email])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50) // e.g., INV-001
  clientId      String        @map("client_id")
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(Draft)
  notes         String?       @db.Text
  total         Decimal       @db.Decimal(12, 2) // Example: Up to 9,999,999,999.99
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict) // Prevent deleting client if invoices exist
  items         InvoiceItem[] // Relation to Invoice Items

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  description String   @db.Text
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(12, 2) // Calculated: quantity * unitPrice

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Delete items if invoice is deleted

  @@index([invoiceId])
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}
